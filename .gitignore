# =========================
# Python bytecode / cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# (any depth)
# =========================
venv/
.venv/
env/
.env/
ENV/
*/venv/
*/.venv/
*/env/
*/.env/
**/venv/
**/.venv/
**/env/
**/.env/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# Packaging / build
# =========================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Test / coverage
# =========================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# IDEs / editors
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# MyPy / Ruff / Pyright
# =========================
.mypy_cache/
.ruff_cache/
.pyright/

# =========================
# SQLite / local data
# =========================
*.sqlite
*.sqlite3
*.db

# =========================
# Artefactos de datos (NO versionar)
# Insumos y productos del ETL: se regeneran o se descargan aparte.
# =========================
data/ingest/
data/indexed/
# El índice se versiona SOLO comprimido (.json.gz), agregado con `git add -f`:
# config.py lo expande al arrancar. Los .json descomprimidos son artefactos
# locales que quedan ignorados por la regla de arriba y no deben subirse.
data/raw/
data/stories/

# Salidas de evaluación (los scripts .py sí se versionan)
etl/eval/eval_dataset*.json
etl/eval/*.log
etl/eval/*.bak
etl/eval/results/
etl/eval/eval_sample*.json
